    "@aws-sdk/client-lambda": "^3.688.0",
    "@devoxa/prisma-relay-cursor-connection": "^3.1.1",
    "@keyv/redis": "^4.0.2",
    "@waterlog/utils": "workspace:*",
    "graphql": "^16.9.0",
    "keyv": "^5.2.1",
    "redis": "^4.7.0",
    "tsconfig": "workspace:*",
    "undici": "^6.20.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.1",
