{
  "name": "@waterlog/graphql-lambda",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --platform=node --sourcemap --bundle --target=node20 --external:@prisma/client --external:.prisma/client --outfile=dist/index.cjs",
    "build:dev": "esbuild src/index.ts --platform=node --sourcemap --packages=external --bundle --target=node20 --outfile=dist/index.cjs",
    "alias": "tsc-alias",
    "test": "pnpm run test:unit --run; pnpm run test:int --run",
    "test:unit": "vitest -c ./vitest.config.unit.ts",
    "test:int": "./scripts/run-integration.sh",
    "generate": "graphql-codegen --config codegen.yml"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@apollo/utils.keyvadapter": "^4.0.0",
