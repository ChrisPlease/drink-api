    "@graphql-codegen/typescript-resolvers": "^4.4.0",
    "@graphql-eslint/eslint-plugin": "^3.20.1",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.17.6",
    "@types/uuid": "^9.0.8",
    "@waterlog/prisma": "workspace:^",
    "esbuild": "^0.20.2",
    "esbuild-plugin-copy": "^2.1.1",
    "graphql-tag": "^2.12.6"
  }
